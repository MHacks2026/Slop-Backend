{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": [
        "./worker-configuration.d.ts",
        "node"
    ]
  },
  // The Worker only: packages/* and scripts/ have their own tsconfigs; supabase/functions is Deno.
  "include": ["src", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "supabase/functions", "scripts", "packages"],
}