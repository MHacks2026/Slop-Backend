# Copy to packages/onshape/.env (gitignored).
# Create an API key at https://dev-portal.onshape.com -> API keys.
# Scopes needed: OAuth2Read, OAuth2Write (documents + part studios).

ONSHAPE_BASE_URL=https://cad.onshape.com
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# "basic" sends accessKey:secretKey as HTTP Basic auth (simplest).
# "hmac" signs each request (Onshape's documented API-key scheme).
ONSHAPE_AUTH_SCHEME=basic

# REST API version segment used for all calls. The guides use v6..v12 for
# different areas; the client pins one version so contract tests stay stable.
ONSHAPE_API_VERSION=v10

# LLM translator (only needed for --planner claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
